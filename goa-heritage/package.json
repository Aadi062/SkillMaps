{
  "name": "goa-unfolded",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first discovery app for Goa's local culture and experiences",
  "scripts": {
    "dev": "concurrently -k \"node server.mjs\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "api": "node server.mjs",
    "build": "vite build",
    "start": "npm run build && node server.mjs",
    "db:seed": "node scripts/seed-database.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}

PORT=4173
HOST=127.0.0.1

# Optional AI provider: hermes | gemini | openrouter | groq | huggingface | openclaw
AI_PROVIDER=hermes
AI_MODEL=

# Provider keys stay on the server; set only the provider you intend to use.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# NousResearch Hermes CLI. Use hermes.exe or an absolute path on Windows.
HERMES_COMMAND=hermes.exe
HERMES_TOOLSETS=web

# OpenClaw Gateway's OpenAI-compatible chat endpoint. Tools are not granted by this app.
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=

# Optional n8n webhook for source cross-checks; direct Wikimedia checks are used otherwise.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Optional PostgreSQL or Supabase direct connection string.
DATABASE_URL=
DATABASE_SSL=false

# Optional browser-visible map tile URL template. Use a restricted public tile token.
VITE_MAP_TILE_URL=

# Optional web research layer: none | gemini | claude | perplexity
RESEARCH_PROVIDER=none
RESEARCH_MODEL=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Set a long unique key before exposing n8n on a shared machine.
N8N_ENCRYPTION_KEY=
POSTGRES_USER=goa
POSTGRES_PASSWORD=
POSTGRES_DB=goa_heritage
